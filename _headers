# The CSP's script hash placeholder is filled in by build.mjs with the sha256 of
# every inline <script> it emits (style-src keeps 'unsafe-inline' because the
# pages use style="" attributes; scripts stay locked down).
# No Cache-Control on /*: Pages already defaults to
# "public, max-age=0, must-revalidate", and Pages joins the values of every
# matching rule with a comma, so setting it here produced a conflicting
# "max-age=0, ..., max-age=31536000" on fonts/images (= revalidated every time).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' {{cspScriptHashes}}; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# site.js is referenced as /assets/site.js?v=<content hash>, so a new build
# gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/media/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and the favicon keep stable filenames, so no "immutable": a replaced
# file reaches returning visitors within a day.
/media/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/media/ico/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/media/pdf/*
  Cache-Control: public, max-age=86400
